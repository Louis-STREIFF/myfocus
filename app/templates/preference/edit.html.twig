{% extends 'base.html.twig' %}

{% block title %}Mes préférences{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">Mes préférences</h1>

    {# Le form_start gère déjà <form method="post" action="..."> #}
    {{ form_start(form) }}

        <div class="mb-3">
            <label class="form-label">Ville</label>
            {{ form_widget(form.city, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.city) }}
        </div>

        <div class="mb-3">
            <label class="form-label">Mots-clés favoris</label>
            {{ form_widget(form.favoriteKeywords, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.favoriteKeywords) }}
            <div class="form-text">
                Exemple : <code>javascript, php, symfony</code>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">
                Retour au dashboard
            </a>
            <button type="submit" class="btn btn-primary">
                Enregistrer
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
