{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1 class="mb-4"> Votre tableau de bord </h1>
    <div class="container py-4">
    <h1 class="mb-4">Votre tableau de bord</h1>

    <div class="mb-4">
        <h2 class="h4">
            Bonjour {{ user.firstname }}{% if city %} de {{ city }}{% endif %}
        </h2>
        {% if city or keywords %}
            <p class="text-muted mb-1">
                {% if city %}Ville : <strong>{{ city }}</strong>{% endif %}
                {% if city and keywords %} • {% endif %}
                {% if keywords %}Mots-clés : <strong>{{ keywords }}</strong>{% endif %}
            </p>
        {% endif %}
<a href="{{ path('app_preference_edit') }}" class="btn btn-primary btn-sm mt-2">
            Modifier mes préférences
        </a>
    </div>

    <div class="row g-4">

        {# Colonne Météo #}
        <div class="col-12 col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    {# Météo{% if city %} - {{ city }}{% endif %} #}
                    Quel temps à {% if city %} {{city}}{% endif %} aujourd'hui?
                </div>
                <div class="card-body">
                    {% if weather %}
                        <h5 class="card-title">
                            {{ weather.weather[0].description|capitalize }}
                        </h5>
                        <p class="card-text mb-2">
                            <strong>Température :</strong> {{ weather.main.temp }} °C<br>
                            <strong>Ressenti :</strong> {{ weather.main.feels_like }} °C<br>
                            <strong>Humidité :</strong> {{ weather.main.humidity }} %
                        </p>
                        {% if weather.wind is defined and weather.wind.speed is defined %}
                            <p class="card-text mb-0">
                                <strong>Vent :</strong> {{ weather.wind.speed }} m/s
                            </p>
                        {% endif %}
                    {% else %}
                        <p class="text-muted mb-0">
                            {% if not city %}
                                Aucune ville configurée pour ton profil.
                            {% else %}
                                Météo indisponible pour le moment.
                            {% endif %}
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Colonne News #}
        <div class="col-12 col-lg-8">
            <div class="card h-100">
                <div class="card-header">
                    Dernières news
                    {% if keywords %}
                        — <span class="fw-normal">{{ keywords }}</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    {% if keywords is empty %}
                        <p class="text-muted">
                            Aucun mot-clé configuré pour ton profil.<br>
                            Va renseigner des mots-clés dans tes préférences pour voir des news.
                        </p>
                    {% elseif news is empty %}
                        <p class="text-muted">
                            Aucune news trouvée pour <strong>{{ keywords }}</strong>.
                        </p>
                    {% else %}
                        <ul class="list-group list-group-flush">
                            {% for article in news %}
                                <li class="list-group-item">
                                    <a href="{{ article.url }}" target="_blank" class="fw-semibold d-block">
                                        {{ article.title }}
                                    </a>
                                    <div class="text-muted small">
                                        {{ article.source.name|default('Source inconnue') }}
                                        {% if article.publishedAt is defined %}
                                            — {{ article.publishedAt|date('d/m/Y H:i') }}
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="container py-4">
            <h3 class="mb-4">Les objectifs du jour</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Objectif</th>
                        <th>Etat</th>
                        <th>Date de réalisation</th>
                    </tr>
                </thead>
                <tbody>
                    {% for objective in objectives %}
                        <tr>
                            <td>{{ objective.label }}</td>

                            <td>
                                {% if objective.status %}
                                    ✔ Fait
                                {% else %}
                                    ☐ À faire
                                {% endif %}
                            </td>

                            <td>
                                {% if objective.targetDate %}
                                    {{ objective.targetDate|date('dd/mm/YYYY') }}

                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">Aucun objectif pour aujourd'hui.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</div>
 

{% endblock %}
